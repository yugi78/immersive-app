---
/**
 * Racine du site : accueil de l'espace client (bouton « Espace client » → /admin/, qui
 * demande la connexion puis ouvre l'espace du projet du compte) et lien vers le site
 * vitrine. Les projets ne sont pas listés : chaque client reçoit l'adresse du sien
 * (/<projet>/).
 *
 * Anciens liens « /#œuvre » (avant le multi-projets) : renvoyés vers le projet par
 * défaut, en gardant l'œuvre.
 */
import { BRAND, SITE } from '../config/brand';
import { PROJECT_SLUGS } from '../viewer/config/projects';
import { withBase } from '../viewer/url';

const legacy = withBase(`/${PROJECT_SLUGS.includes('pantheon') ? 'pantheon' : PROJECT_SLUGS[0]}/`);
// Espace client : sur le même site (Cloudflare), ou à une autre adresse quand ce site
// est servi sans fonctions serveur (GitHub Pages → PUBLIC_ADMIN_URL, voir deploy.yml).
const admin = import.meta.env.PUBLIC_ADMIN_URL || withBase('/admin/');
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<title>{BRAND} · Espace client</title>
		<meta name="description" content="Visites immersives en 3D : accès à l'espace client." />
		<script is:inline define:vars={{ legacy }}>
			if (location.hash.length > 1) location.replace(legacy + location.hash);
		</script>
		<style is:global>
			@font-face {
				font-family: 'Mona Sans';
				src: url('/fonts/mona-sans/mona-sans-vf.woff2') format('woff2');
				font-weight: 200 900;
				font-stretch: 75% 125%;
				font-display: swap;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				background: #f3f2ef;
				color: #141414;
				font-family: 'Mona Sans', system-ui, sans-serif;
			}
			body {
				display: grid;
				grid-template-rows: 1fr auto;
			}
			main {
				display: grid;
				place-items: center;
				padding: 24px;
			}
			.card {
				width: min(440px, 100%);
				display: grid;
				gap: 14px;
				padding: 36px 32px 32px;
				border-radius: 22px;
				background: #fff;
				box-shadow: 0 10px 40px rgb(20 20 20 / 0.08);
				box-sizing: border-box;
			}
			.mark {
				width: 44px;
				height: 44px;
				border-radius: 13px;
				background: #141414;
				color: #fff;
				display: grid;
				place-items: center;
			}
			h1 {
				margin: 8px 0 0;
				font-size: 28px;
				font-weight: 650;
				font-stretch: 112%;
				letter-spacing: -0.01em;
			}
			p {
				margin: 0 0 8px;
				color: #6b6862;
				font-size: 15px;
				line-height: 1.5;
			}
			.btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				height: 48px;
				border-radius: 12px;
				font-weight: 600;
				font-size: 15px;
				text-decoration: none;
			}
			.btn.primary {
				background: #3b5bff;
				color: #fff;
			}
			.btn.primary:hover {
				background: #2f4ae0;
			}
			.btn.ghost {
				border: 1px solid #d6d3cd;
				color: #141414;
			}
			.btn.ghost:hover {
				border-color: #141414;
			}
			.btn:focus-visible {
				outline: 2px solid #3b5bff;
				outline-offset: 2px;
			}
			footer {
				padding: 18px 24px 22px;
				text-align: center;
				color: #8a867f;
				font-size: 13px;
			}
			footer a {
				color: inherit;
			}
		</style>
	</head>
	<body>
		<main>
			<div class="card">
				<span class="mark" aria-hidden="true">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M6 20v-7M10 20v-7M14 20v-7M18 20v-7M4 13h16M6 13a6 6 0 0 1 12 0M12 4v3"></path></svg>
				</span>
				<h1>{BRAND}</h1>
				<p>Visites immersives en 3D. Connectez-vous pour modifier le contenu de votre visite : points d'intérêt, textes, images et parcours.</p>
				<a class="btn primary" href={admin}>
					Espace client
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
				<a class="btn ghost" href={SITE.url}>Découvrir nos réalisations</a>
			</div>
		</main>
		<footer>
			<a href={SITE.url}>{SITE.label}</a>
		</footer>
	</body>
</html>
