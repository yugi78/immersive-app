---
/**
 * Accueil du back-office : /admin/, la liste des projets, chacun ouvrant son back-office.
 * - En local (développeur) : accès direct.
 * - En ligne : réservé aux comptes « tous projets » (fonction functions/admin/_middleware.ts) ;
 *   un compte client est renvoyé vers l'espace de son projet avant d'arriver ici.
 */
import { BRAND } from '../config/brand';
import { PROJECT_SLUGS, PROJECTS } from '../viewer/config/projects';
import { withBase } from '../viewer/url';

const local = import.meta.env.DEV;
const projects = PROJECT_SLUGS.map((slug) => {
	const cfg = PROJECTS[slug];
	return {
		slug,
		name: cfg.project?.name ?? slug,
		works: cfg.tour?.works?.length ?? 0,
		objects: cfg.objects?.length ?? 0,
		thumb: cfg.tour?.works?.find((w) => w.thumbnail)?.thumbnail ?? '',
	};
});
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Projets — {BRAND}</title>
		<style is:global>
			@font-face {
				font-family: 'Mona Sans';
				src: url('/fonts/mona-sans/mona-sans-vf.woff2') format('woff2');
				font-weight: 200 900;
				font-stretch: 75% 125%;
				font-display: swap;
			}
			html,
			body {
				margin: 0;
				min-height: 100%;
				background: #f3f2ef;
				color: #141414;
				font-family: 'Mona Sans', system-ui, sans-serif;
				font-size: 14px;
			}
			header {
				display: flex;
				align-items: center;
				gap: 12px;
				height: 60px;
				padding: 0 24px;
				background: #fff;
				border-bottom: 1px solid #e6e4df;
			}
			.mark {
				display: grid;
				place-items: center;
				width: 32px;
				height: 32px;
				border-radius: 10px;
				background: #141414;
				color: #fff;
			}
			header b {
				font-size: 15px;
			}
			header span {
				color: #6b6862;
			}
			header button {
				margin-left: auto;
				height: 34px;
				padding: 0 14px;
				border: 1px solid #d6d3cd;
				border-radius: 10px;
				background: #fff;
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}
			header button:hover {
				border-color: #141414;
			}
			main {
				max-width: 1080px;
				margin: 0 auto;
				padding: 40px 24px;
			}
			h1 {
				margin: 0 0 6px;
				font-size: 28px;
				font-weight: 650;
			}
			.lead {
				margin: 0 0 28px;
				color: #6b6862;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 18px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			li {
				display: flex;
				flex-direction: column;
				border-radius: 18px;
				background: #fff;
				overflow: hidden;
				box-shadow: 0 6px 24px rgb(20 20 20 / 0.06);
			}
			.thumb {
				aspect-ratio: 16 / 9;
				background: #e9e7e2 center / cover no-repeat;
			}
			.body {
				display: grid;
				gap: 4px;
				padding: 16px 18px 18px;
			}
			.name {
				font-size: 18px;
				font-weight: 650;
			}
			.meta {
				color: #6b6862;
			}
			.actions {
				display: flex;
				gap: 8px;
				margin-top: 12px;
			}
			.actions a {
				display: inline-flex;
				align-items: center;
				height: 36px;
				padding: 0 14px;
				border-radius: 10px;
				border: 1px solid #d6d3cd;
				color: inherit;
				font-weight: 600;
				text-decoration: none;
			}
			.actions a.primary {
				border-color: #3b5bff;
				background: #3b5bff;
				color: #fff;
			}
			li.new {
				display: grid;
				place-items: center;
				min-height: 200px;
				border: 1.5px dashed #cfccc6;
				background: transparent;
				box-shadow: none;
				color: #6b6862;
				text-align: center;
				padding: 24px;
			}
		</style>
	</head>
	<body>
					<header>
						<span class="mark" aria-hidden="true">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 20h16M6 20v-7M10 20v-7M14 20v-7M18 20v-7M4 13h16M6 13a6 6 0 0 1 12 0M12 4v3" />
							</svg>
						</span>
						<b>{BRAND}</b>
						<span>· projets</span>
						{!local && <button type="button" id="logout">Se déconnecter</button>}
					</header>
					<main>
						<h1>Projets</h1>
						<p class="lead">
							{local
								? 'Un dossier par projet dans projects/. Ouvre un projet pour régler sa scène et son contenu.'
								: 'Ouvre un projet pour modifier son contenu. La structure (fichiers 3D, scan) se règle en local.'}
						</p>
						<ul>
							{projects.map((p) => (
								<li>
									<div class="thumb" style={p.thumb ? `background-image:url('${withBase(p.thumb)}')` : ''} />
									<div class="body">
										<span class="name">{p.name}</span>
										<span class="meta">
											/{p.slug} · {p.objects} objets · {p.works} œuvre{p.works > 1 ? 's' : ''}
										</span>
										<div class="actions">
											<a class="primary" href={withBase(`/${p.slug}/admin/`)}>
												Ouvrir
											</a>
											<a href={withBase(`/${p.slug}/`)} target="_blank" rel="noopener">
												Voir le site
											</a>
										</div>
									</div>
								</li>
							))}
							{local && <li class="new">Nouveau projet : bientôt (création depuis cet accueil).</li>}
						</ul>
					</main>
		<script>
			document.querySelector('#logout')?.addEventListener('click', async () => {
				await fetch('/api/logout', { method: 'POST' }).catch(() => {});
				location.assign('/');
			});
		</script>
	</body>
</html>
