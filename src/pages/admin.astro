---
import SceneEditor from '../admin/SceneEditor';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Back-office — Panthéon interactif</title>
		<style is:global>
			html,
			body {
				margin: 0;
				height: 100%;
			}
		</style>
	</head>
	<body>
		{
			import.meta.env.DEV ? (
				<SceneEditor client:only="react" />
			) : (
				<p style="font-family: system-ui; padding: 24px">Le back-office n'est disponible qu'en développement (astro dev).</p>
			)
		}
	</body>
</html>
