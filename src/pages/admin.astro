---
import SceneEditor from '../admin/SceneEditor';
import { BRAND, PROJECT } from '../config/brand';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{PROJECT.name} — {BRAND}</title>
		<style is:global>
			html,
			body {
				margin: 0;
				height: 100%;
			}
		</style>
	</head>
	<body>
		{/* En local : administration complète. En ligne : espace client (protégé par la connexion). */}
		<SceneEditor client:only="react" />
	</body>
</html>
