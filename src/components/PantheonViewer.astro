---
// Island client isolée : le viewer Three.js ne dépend pas du reste du site.
---

<div class="pantheon-viewer" data-pantheon-viewer></div>

<script>
  import { createViewer } from '../viewer';

  for (const el of document.querySelectorAll<HTMLElement>('[data-pantheon-viewer]')) {
    createViewer(el).catch(() => {});
  }
</script>

<style is:global>
  .pantheon-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    touch-action: none;
    background: #dfe4ea;
  }
  .pantheon-viewer canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pv-loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 12px;
    font: 500 14px/1.3 system-ui, sans-serif;
    color: #3b4048;
    text-align: center;
    transition: opacity 0.5s ease;
  }
  .pv-loader.is-done {
    opacity: 0;
    pointer-events: none;
  }
  .pv-loader.is-error {
    color: #b42318;
  }
  .pv-loader__track {
    width: min(280px, 70vw);
    height: 3px;
    background: rgb(0 0 0 / 0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .pv-loader__bar {
    height: 100%;
    background: #3b4048;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s linear;
  }
</style>
